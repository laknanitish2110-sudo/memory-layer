{
  "name": "@memory-layer/protocol",
  "version": "0.1.0",
  "description": "Memory Passport Protocol Kernel — deterministic enforcement of protocol invariants",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run tests/conformance",
    "test:adversarial": "vitest run tests/adversarial"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
