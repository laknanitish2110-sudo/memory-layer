{
  "name": "@memory-layer/core",
  "version": "0.1.0",
  "description": "Universal memory layer for AI applications",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx demo/server.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laknanitish2110-sudo/memory-layer.git"
  },
  "keywords": [
    "ai",
    "memory",
    "llm",
    "cross-app",
    "user-memory",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/laknanitish2110-sudo/memory-layer/issues"
  },
  "homepage": "https://github.com/laknanitish2110-sudo/memory-layer#readme",
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "express": "^5.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
